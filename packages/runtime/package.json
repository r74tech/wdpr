{
  "name": "@wdprlib/runtime",
  "version": "0.1.0",
  "description": "Client-side runtime for Wikidot markup",
  "keywords": [
    "markup",
    "parser",
    "runtime",
    "wikidot"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/r74tech/wdpr.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
