{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "versions": {
    "stable": "auto",
    "dev": "auto",
    "packageFile": "package.json",
    "makeRelativeLinks": true,
    "monorepo": {
      "name": "render",
      "root": "../../docs"
    }
  },
  "plugin": [
    "@r74tech/typedoc-plugin-monorepo-versions"
  ]
}
