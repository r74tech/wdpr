{
  "name": "@wdprlib/render",
  "version": "1.0.0-rc.0",
  "description": "HTML renderer for Wikidot markup",
  "keywords": [
    "html",
    "markup",
    "parser",
    "renderer",
    "wikidot"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/r74tech/wdpr.git",
    "directory": "packages/render"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@wdprlib/ast": "workspace:*",
    "dompurify": "^3.3.1",
    "jsdom": "^28.0.0",
    "temml": "^0.13.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^27.0.0"
  }
}
