{
  "name": "@wdprlib/ast",
  "version": "4.1.0",
  "description": "AST types for Wikidot markup",
  "keywords": [
    "ast",
    "markup",
    "parser",
    "wikidot"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/r74tech/wdpr.git",
    "directory": "packages/ast"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
