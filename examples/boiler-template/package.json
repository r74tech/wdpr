{
  "name": "@wdpr/example-boiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:main dev:files",
    "dev:main": "vite",
    "dev:files": "wrangler dev -c wrangler.files.jsonc --persist-to .wrangler/state --inspector-port 9232",
    "db:migrate:local": "wrangler d1 migrations apply wdpr-boiler-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wdpr-boiler-db --remote",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:files": "wrangler deploy -c wrangler.files.jsonc",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.files.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@wdprlib/parser": "workspace:*",
    "@wdprlib/render": "workspace:*",
    "@wdprlib/runtime": "workspace:*",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
