{
  "name": "@wdprlib/parser",
  "version": "4.3.1",
  "description": "Parser for Wikidot markup",
  "keywords": [
    "ast",
    "markup",
    "parser",
    "wikidot"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/r74tech/wdpr.git",
    "directory": "packages/parser"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.1",
    "@wdprlib/ast": "workspace:*"
  }
}
