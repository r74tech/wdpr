{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/**/*.ts"],
  "tsconfig": "tsconfig.typedoc.json",
  "validation": {
    "notExported": false
  },
  "versions": {
    "stable": "auto",
    "dev": "auto",
    "packageFile": "package.json",
    "makeRelativeLinks": true,
    "monorepo": {
      "name": "parser",
      "root": "../../docs"
    }
  },
  "plugin": ["@r74tech/typedoc-plugin-monorepo-versions"]
}
